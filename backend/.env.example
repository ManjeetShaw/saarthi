# Copy to .env and adjust as needed.

# Either set DATABASE_URL (wins if present)...
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/joineazy

# ...or use the discrete DB_* vars (used when DATABASE_URL is unset):
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=joineazy
DB_SSL=false

# Secret used to sign JWTs. Change this in any real deployment.
JWT_SECRET=dev_secret_change_me

# Comma-separated list of origins allowed to call the API with credentials.
FRONTEND_URL=http://localhost:3000

PORT=5000
